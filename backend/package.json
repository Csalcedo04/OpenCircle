{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --env-file-if-exists=.env --import tsx --test \"test/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs migrate",
    "op:check": "node --env-file=.env --import tsx src/scripts/check-op-client.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@interledger/open-payments": "7.4.0",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "2.117.3",
    "drizzle-orm": "0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "drizzle-kit": "0.31.11",
    "jose": "6.2.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
