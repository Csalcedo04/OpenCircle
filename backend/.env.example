PORT=3000

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"

# Supabase project URL. User JWTs are verified against <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_URL="https://<project-ref>.supabase.co"

# Next app origin; the user's wallet redirects back here after Open Payments consent.
FRONTEND_URL="http://localhost:3001"

# OpenCircle's Open Payments client identity (Interledger test wallet: Settings → Developer Keys).
# Check with: npm run op:check
OP_CLIENT_WALLET_ADDRESS="https://ilp.interledger-test.dev/<project-wallet>"
OP_KEY_ID="<key id published in <wallet address>/jwks.json>"
OP_PRIVATE_KEY="<base64 of the downloaded private.key>"

# Encrypts stored GNAP tokens. Generate without printing:
#   echo "GRANT_TOKEN_KEY=$(openssl rand -base64 32)" >> .env
GRANT_TOKEN_KEY="<32 random bytes, base64>"

# Didit KYC (business console). Server-only; never prefix with NEXT_PUBLIC_.
DIDIT_API_KEY="<application API key>"
DIDIT_WORKFLOW_ID="<KYC workflow id (uuid)>"
# Webhook destination's secret_shared_key (shown once when the destination is created).
# Optional locally: without it POST /api/webhooks/didit answers 503 and status comes from the decision API.
DIDIT_WEBHOOK_SECRET="<webhook secret>"

# Dev only: Stripe-style test clocks for circles (POST /api/test-clocks, advance, dev panel).
# Leave unset (false) in production. See docs/test-clock.md.
TEST_CLOCKS_ENABLED=false
