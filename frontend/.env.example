# Copy to .env.local and fill in. Never commit real values.

# Public: safe in the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only: bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Server-only: base URL of the Express API (backend/). Never prefix with NEXT_PUBLIC_.
BACKEND_API_URL=http://localhost:4000

# Dev only: show the test clock pages (/[lang]/dev/test-clocks). Server-side; never NEXT_PUBLIC_.
# The backend needs TEST_CLOCKS_ENABLED=true too.
TEST_CLOCKS_ENABLED=false
